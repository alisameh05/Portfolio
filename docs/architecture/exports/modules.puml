@startuml
title <size:24>Component View: ShipWithAli - Next.js Application</size>\n<size:24>The nine deep domain modules, delivery surfaces, Provider Adapters, stores, and external integrations.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

Person(Visitor, "Visitor", $descr="Explores public work, reads Case studies, accesses the Current CV, interacts with Projects, and uses Contact channels without an account.", $tags="", $link="")
Person(Owner, "Owner", $descr="The single authenticated operator who publishes content, manages configuration, moderates Feedback, activates CV versions, reviews analytics, and produces Owner exports.", $tags="", $link="")

System(SupabaseAuth, "Supabase Auth", $descr="Creates application sessions and delegates the Owner identity challenge to GitHub OAuth.", $tags="", $link="")
System(VercelPlatform, "Vercel Platform", $descr="Provides CDN delivery, serverless execution, cache tags, preview promotion, rollback, and scheduled invocation.", $tags="", $link="")
System(Resend, "Resend", $descr="Delivers best-effort actionable Owner notifications without participating in publication transactions.", $tags="", $link="")
System(Sentry, "Sentry", $descr="Receives scrubbed exceptions and sampled traces for actionable operational diagnosis.", $tags="", $link="")
System(ExternalDestinations, "External Destinations", $descr="Hosts GitHub repositories, live demos, professional profiles, social channels, and other truthfully labeled Project or Contact destinations.", $tags="", $link="")

System_Boundary("ShipWithAli_boundary", "ShipWithAli", $tags="") {
  Container_Boundary("ShipWithAli.NextjsApplication_boundary", "Next.js Application", $tags="") {
    Component(ShipWithAli.NextjsApplication.Media, "Media", $techn="TypeScript domain module", $descr="Owns private upload candidates, safety and suitability checks, accessibility metadata, accepted Media assets, provider-independent object references, and variants.", $tags="", $link="")
    Component(ShipWithAli.NextjsApplication.CVPortfolio, "CV Portfolio", $techn="TypeScript domain module", $descr="Owns accepted CV versions and atomically maintains the single English Current CV designation.", $tags="", $link="")
    Component(ShipWithAli.NextjsApplication.InteractionandModeration, "Interaction and Moderation", $techn="TypeScript domain module", $descr="Owns Reactions, Ratings, private Feedback, immutable Moderation decisions, current choices, and public aggregates.", $tags="", $link="")
    Component(ShipWithAli.NextjsApplication.Measurement, "Measurement", $techn="TypeScript domain module", $descr="Owns consented Public event data, Analytics goal versions, Journey context, daily aggregates, retention, and Low-sample reporting.", $tags="", $link="")
    Component(ShipWithAli.NextjsApplication.IdentityandAccess, "Identity and Access", $techn="TypeScript domain module", $descr="Authorizes the allowlisted Owner, scheduled jobs, short-lived abuse signals, consent state, and separate functional and analytics identities.", $tags="", $link="")
    Component(ShipWithAli.NextjsApplication.PortabilityandOperations, "Portability and Operations", $techn="TypeScript domain module and PostgreSQL-backed job runner", $descr="Owns Owner export schemas and integrity, outbox records, job leases, retries, backup evidence, recovery state, and actionable Operational alerts.", $tags="", $link="")
    Component(ShipWithAli.NextjsApplication.ProviderAdapters, "Provider Adapters", $techn="TypeScript adapters and provider SDKs", $descr="Implements seams for PostgreSQL transactions and repositories, Supabase Storage and Auth, GitHub OAuth, Vercel cache and scheduling, Resend, Sentry, clocks, and backup artifacts.", $tags="", $link="")
    Component(ShipWithAli.NextjsApplication.PublicExperience, "Public Experience", $techn="Next.js Server Components and narrow Route Handlers", $descr="Resolves locale and durable routes, renders the landing page, discovery, Timeline, Case studies, Current CV access, interactions, and graceful fallbacks.", $tags="", $link="")
    Component(ShipWithAli.NextjsApplication.OwnerWorkspace, "Owner Workspace", $techn="Next.js Server Actions and private Route Handlers", $descr="Maps authenticated forms to conceptual Owner commands and displays drafts, Moderation, analytics, exports, and operational state.", $tags="", $link="")
    Component(ShipWithAli.NextjsApplication.PortfolioConfiguration, "Portfolio Configuration", $techn="TypeScript domain module", $descr="Owns the public profile, Contact channels, Global project CTA, safe destination availability, and their histories.", $tags="", $link="")
    Component(ShipWithAli.NextjsApplication.ContentandPublishing, "Content and Publishing", $techn="TypeScript domain module", $descr="Owns Projects, Achievements, Testimonials, immutable Revisions, evidence, lifecycle, language publications, Project relationships, External links, routes, and redirects.", $tags="", $link="")
    Component(ShipWithAli.NextjsApplication.TaxonomyandDiscovery, "Taxonomy and Discovery", $techn="TypeScript domain module and PostgreSQL full-text/trigram search", $descr="Owns controlled Taxonomies, value evolution, searchable public Project projections, filters, and newest-published ordering.", $tags="", $link="")
  }

  ContainerDb(ShipWithAli.PortfolioDatabase, "Portfolio Database", $techn="Supabase PostgreSQL with connection pooling", $descr="Stores module-owned relational records, public read projections, immutable histories, idempotency records, outbox entries, and job leases under Row Level Security.", $tags="", $link="")
  Container(ShipWithAli.ObjectStorage, "Object Storage", $techn="Supabase Storage through an object-storage adapter", $descr="Keeps private upload candidates, accepted public media variants, Current CV objects, encrypted exports, and recovery artifacts behind stable Media asset identities.", $tags="", $link="")
}

Rel(ShipWithAli.NextjsApplication.PortabilityandOperations, ShipWithAli.NextjsApplication.Measurement, "Runs aggregation and retention jobs", $techn="In-process idempotent job handler", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.PortabilityandOperations, ShipWithAli.NextjsApplication.InteractionandModeration, "Runs Feedback retention and aggregate repair jobs", $techn="In-process idempotent job handler", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.PortabilityandOperations, ShipWithAli.NextjsApplication.Media, "Runs media validation and recovery jobs", $techn="In-process idempotent job handler", $tags="", $link="")
Rel(Visitor, ExternalDestinations, "Follows truthfully labeled Project and Contact destinations", $techn="HTTPS or explicitly allowed contact scheme", $tags="", $link="")
Rel(Visitor, ShipWithAli.NextjsApplication.PublicExperience, "Requests public pages and permitted mutations", $techn="HTTPS", $tags="", $link="")
Rel(Owner, ShipWithAli.NextjsApplication.OwnerWorkspace, "Submits authenticated Owner commands", $techn="HTTPS", $tags="", $link="")
Rel(VercelPlatform, ShipWithAli.NextjsApplication.PublicExperience, "Delivers cached requests to the application", $techn="Vercel CDN and HTTPS", $tags="", $link="")
Rel(VercelPlatform, ShipWithAli.NextjsApplication.PortabilityandOperations, "Invokes scheduled job batches", $techn="Authenticated HTTPS", $tags="", $link="")
