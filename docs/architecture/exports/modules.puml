Rel(ShipWithAli.NextjsApplication.CVPortfolio, ShipWithAli.NextjsApplication.ProviderAdapters, "Persists versions and Current CV replacement atomically", $techn="Transaction and repository port", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.InteractionandModeration, ShipWithAli.NextjsApplication.ProviderAdapters, "Persists idempotent interactions, Feedback, decisions, aggregates, and outbox entries", $techn="Transaction, repository, and rate-limit ports", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.Measurement, ShipWithAli.NextjsApplication.ProviderAdapters, "Persists allowlisted events, goals, aggregates, retention work, and outbox entries", $techn="Transaction and repository port", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.IdentityandAccess, ShipWithAli.NextjsApplication.ProviderAdapters, "Verifies OAuth sessions, schedules, signed identities, and short-lived abuse signals", $techn="Authentication, clock, and cryptography ports", $tags="", $link="")
