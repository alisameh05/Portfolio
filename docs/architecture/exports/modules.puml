Rel(ShipWithAli.NextjsApplication.PublicExperience, ShipWithAli.NextjsApplication.CVPortfolio, "Resolves the locale-appropriate Current CV result", $techn="In-process TypeScript interface", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.PublicExperience, ShipWithAli.NextjsApplication.InteractionandModeration, "Submits interactions and reads public aggregates", $techn="In-process TypeScript interface", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.PublicExperience, ShipWithAli.NextjsApplication.Measurement, "Records consented allowlisted events", $techn="In-process TypeScript interface", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.PublicExperience, ExternalDestinations, "Renders truthfully labeled outbound destinations", $techn="HTTPS links", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.OwnerWorkspace, ShipWithAli.NextjsApplication.IdentityandAccess, "Requires the allowlisted Owner for every command", $techn="In-process TypeScript interface", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.OwnerWorkspace, ShipWithAli.NextjsApplication.PortfolioConfiguration, "Manages public configuration", $techn="In-process TypeScript interface", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.OwnerWorkspace, ShipWithAli.NextjsApplication.ContentandPublishing, "Executes publishing commands", $techn="In-process TypeScript interface", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.OwnerWorkspace, ShipWithAli.NextjsApplication.TaxonomyandDiscovery, "Executes Taxonomy commands", $techn="In-process TypeScript interface", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.OwnerWorkspace, ShipWithAli.NextjsApplication.Media, "Prepares and accepts Media assets", $techn="In-process TypeScript interface", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.OwnerWorkspace, ShipWithAli.NextjsApplication.CVPortfolio, "Accepts and activates CV versions", $techn="In-process TypeScript interface", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.OwnerWorkspace, ShipWithAli.NextjsApplication.InteractionandModeration, "Reviews and moderates Feedback", $techn="In-process TypeScript interface", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.OwnerWorkspace, ShipWithAli.NextjsApplication.Measurement, "Manages Analytics goals and reads reports", $techn="In-process TypeScript interface", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.OwnerWorkspace, ShipWithAli.NextjsApplication.PortabilityandOperations, "Requests exports and reads operational state", $techn="In-process TypeScript interface", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.ContentandPublishing, ShipWithAli.NextjsApplication.Media, "Validates accepted public Media references", $techn="In-process TypeScript interface", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.ContentandPublishing, ShipWithAli.NextjsApplication.TaxonomyandDiscovery, "Validates controlled classifications and updates the public search projection", $techn="In-process TypeScript interface", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.ContentandPublishing, ShipWithAli.NextjsApplication.PortfolioConfiguration, "Reads the Global project CTA and destination availability", $techn="In-process TypeScript interface", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.CVPortfolio, ShipWithAli.NextjsApplication.Media, "Validates that a candidate CV file is accepted", $techn="In-process TypeScript interface", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.InteractionandModeration, ShipWithAli.NextjsApplication.IdentityandAccess, "Obtains purpose-limited functional identity and abuse policy", $techn="In-process TypeScript interface", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.Measurement, ShipWithAli.NextjsApplication.IdentityandAccess, "Validates consent and purpose-limited analytics identity", $techn="In-process TypeScript interface", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.PortfolioConfiguration, ShipWithAli.NextjsApplication.ProviderAdapters, "Persists configuration through its owned repository", $techn="Transaction and repository port", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.ContentandPublishing, ShipWithAli.NextjsApplication.ProviderAdapters, "Commits domain state, route projections, and outbox records atomically", $techn="Transaction and repository port", $tags="", $link="")
