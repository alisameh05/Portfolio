@startuml
title <size:24>Dynamic View: ShipWithAli - Next.js Application</size>\n<size:24>Reviewed publication, media validation, atomic persistence, outbox work, and cache invalidation.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

Person(Owner, "Owner", $descr="The single authenticated operator who publishes content, manages configuration, moderates Feedback, activates CV versions, reviews analytics, and produces Owner exports.", $tags="", $link="")

System(SupabaseAuth, "Supabase Auth", $descr="Creates application sessions and delegates the Owner identity challenge to GitHub OAuth.", $tags="", $link="")
System(VercelPlatform, "Vercel Platform", $descr="Provides CDN delivery, serverless execution, cache tags, preview promotion, rollback, and scheduled invocation.", $tags="", $link="")

System_Boundary("ShipWithAli_boundary", "ShipWithAli", $tags="") {
  Container_Boundary("ShipWithAli.NextjsApplication_boundary", "Next.js Application", $tags="") {
    Component(ShipWithAli.NextjsApplication.Media, "Media", $techn="TypeScript domain module", $descr="Owns private upload candidates, safety and suitability checks, accessibility metadata, accepted Media assets, provider-independent object references, and variants.", $tags="", $link="")
    Component(ShipWithAli.NextjsApplication.IdentityandAccess, "Identity and Access", $techn="TypeScript domain module", $descr="Authorizes the allowlisted Owner, scheduled jobs, short-lived abuse signals, consent state, and separate functional and analytics identities.", $tags="", $link="")
    Component(ShipWithAli.NextjsApplication.PortabilityandOperations, "Portability and Operations", $techn="TypeScript domain module and PostgreSQL-backed job runner", $descr="Owns Owner export schemas and integrity, outbox records, job leases, retries, backup evidence, recovery state, and actionable Operational alerts.", $tags="", $link="")
    Component(ShipWithAli.NextjsApplication.ProviderAdapters, "Provider Adapters", $techn="TypeScript adapters and provider SDKs", $descr="Implements seams for PostgreSQL transactions and repositories, Supabase Storage and Auth, GitHub OAuth, Vercel cache and scheduling, Resend, Sentry, clocks, and backup artifacts.", $tags="", $link="")
    Component(ShipWithAli.NextjsApplication.OwnerWorkspace, "Owner Workspace", $techn="Next.js Server Actions and private Route Handlers", $descr="Maps authenticated forms to conceptual Owner commands and displays drafts, Moderation, analytics, exports, and operational state.", $tags="", $link="")
    Component(ShipWithAli.NextjsApplication.ContentandPublishing, "Content and Publishing", $techn="TypeScript domain module", $descr="Owns Projects, Achievements, Testimonials, immutable Revisions, evidence, lifecycle, language publications, Project relationships, External links, routes, and redirects.", $tags="", $link="")
    Component(ShipWithAli.NextjsApplication.TaxonomyandDiscovery, "Taxonomy and Discovery", $techn="TypeScript domain module and PostgreSQL full-text/trigram search", $descr="Owns controlled Taxonomies, value evolution, searchable public Project projections, filters, and newest-published ordering.", $tags="", $link="")
  }

  ContainerDb(ShipWithAli.PortfolioDatabase, "Portfolio Database", $techn="Supabase PostgreSQL with connection pooling", $descr="Stores module-owned relational records, public read projections, immutable histories, idempotency records, outbox entries, and job leases under Row Level Security.", $tags="", $link="")
}

Person(Owner, "Owner", $descr="The single authenticated operator who publishes content, manages configuration, moderates Feedback, activates CV versions, reviews analytics, and produces Owner exports.", $tags="", $link="")
ContainerDb(ShipWithAli.PortfolioDatabase, "Portfolio Database", $techn="Supabase PostgreSQL with connection pooling", $descr="Stores module-owned relational records, public read projections, immutable histories, idempotency records, outbox entries, and job leases under Row Level Security.", $tags="", $link="")
System(SupabaseAuth, "Supabase Auth", $descr="Creates application sessions and delegates the Owner identity challenge to GitHub OAuth.", $tags="", $link="")
System(VercelPlatform, "Vercel Platform", $descr="Provides CDN delivery, serverless execution, cache tags, preview promotion, rollback, and scheduled invocation.", $tags="", $link="")

Rel(Owner, ShipWithAli.NextjsApplication.OwnerWorkspace, "1: Requests publication of one reviewed Language version", $techn="HTTPS", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.OwnerWorkspace, ShipWithAli.NextjsApplication.IdentityandAccess, "2: Requires the allowlisted Owner", $techn="In-process TypeScript interface", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.IdentityandAccess, ShipWithAli.NextjsApplication.ProviderAdapters, "3: Verifies the session", $techn="Authentication, clock, and cryptography ports", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.ProviderAdapters, SupabaseAuth, "4: Validates the GitHub-backed session", $techn="Supabase Auth over HTTPS", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.OwnerWorkspace, ShipWithAli.NextjsApplication.ContentandPublishing, "5: Executes PublishLanguageVersion", $techn="In-process TypeScript interface", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.ContentandPublishing, ShipWithAli.NextjsApplication.Media, "6: Validates accepted Media references and accessibility metadata", $techn="In-process TypeScript interface", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.ContentandPublishing, ShipWithAli.NextjsApplication.TaxonomyandDiscovery, "7: Validates controlled classifications and stages the public projection", $techn="In-process TypeScript interface", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.ContentandPublishing, ShipWithAli.NextjsApplication.ProviderAdapters, "8: Atomically commits publication, route, projection, and outbox records", $techn="Transaction and repository port", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.ProviderAdapters, ShipWithAli.PortfolioDatabase, "9: Commits the transaction", $techn="PostgreSQL over TLS", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.PortabilityandOperations, ShipWithAli.NextjsApplication.ProviderAdapters, "10: Leases the cache-invalidation job", $techn="Repository, storage, cache, email, monitoring, and clock ports", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.ProviderAdapters, VercelPlatform, "11: Invalidates stable identity and locale cache tags", $techn="Vercel runtime interface", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml
