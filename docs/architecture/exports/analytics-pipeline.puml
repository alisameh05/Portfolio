@startuml
title <size:24>Dynamic View: ShipWithAli - Next.js Application</size>\n<size:24>Consent validation, minimized event intake, durable aggregation, retention, and Owner reporting.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

Person(Visitor, "Visitor", $descr="Explores public work, reads Case studies, accesses the Current CV, interacts with Projects, and uses Contact channels without an account.", $tags="", $link="")
Person(Owner, "Owner", $descr="The single authenticated operator who publishes content, manages configuration, moderates Feedback, activates CV versions, reviews analytics, and produces Owner exports.", $tags="", $link="")

System(VercelPlatform, "Vercel Platform", $descr="Provides CDN delivery, serverless execution, cache tags, preview promotion, rollback, and scheduled invocation.", $tags="", $link="")

System_Boundary("ShipWithAli_boundary", "ShipWithAli", $tags="") {
  Container_Boundary("ShipWithAli.NextjsApplication_boundary", "Next.js Application", $tags="") {
    Component(ShipWithAli.NextjsApplication.Measurement, "Measurement", $techn="TypeScript domain module", $descr="Owns consented Public event data, Analytics goal versions, Journey context, daily aggregates, retention, and Low-sample reporting.", $tags="", $link="")
    Component(ShipWithAli.NextjsApplication.IdentityandAccess, "Identity and Access", $techn="TypeScript domain module", $descr="Authorizes the allowlisted Owner, scheduled jobs, short-lived abuse signals, consent state, and separate functional and analytics identities.", $tags="", $link="")
    Component(ShipWithAli.NextjsApplication.PortabilityandOperations, "Portability and Operations", $techn="TypeScript domain module and PostgreSQL-backed job runner", $descr="Owns Owner export schemas and integrity, outbox records, job leases, retries, backup evidence, recovery state, and actionable Operational alerts.", $tags="", $link="")
    Component(ShipWithAli.NextjsApplication.ProviderAdapters, "Provider Adapters", $techn="TypeScript adapters and provider SDKs", $descr="Implements seams for PostgreSQL transactions and repositories, Supabase Storage and Auth, GitHub OAuth, Vercel cache and scheduling, Resend, Sentry, clocks, and backup artifacts.", $tags="", $link="")
    Component(ShipWithAli.NextjsApplication.PublicExperience, "Public Experience", $techn="Next.js Server Components and narrow Route Handlers", $descr="Resolves locale and durable routes, renders the landing page, discovery, Timeline, Case studies, Current CV access, interactions, and graceful fallbacks.", $tags="", $link="")
    Component(ShipWithAli.NextjsApplication.OwnerWorkspace, "Owner Workspace", $techn="Next.js Server Actions and private Route Handlers", $descr="Maps authenticated forms to conceptual Owner commands and displays drafts, Moderation, analytics, exports, and operational state.", $tags="", $link="")
  }

  ContainerDb(ShipWithAli.PortfolioDatabase, "Portfolio Database", $techn="Supabase PostgreSQL with connection pooling", $descr="Stores module-owned relational records, public read projections, immutable histories, idempotency records, outbox entries, and job leases under Row Level Security.", $tags="", $link="")
}

Person(Visitor, "Visitor", $descr="Explores public work, reads Case studies, accesses the Current CV, interacts with Projects, and uses Contact channels without an account.", $tags="", $link="")
Person(Owner, "Owner", $descr="The single authenticated operator who publishes content, manages configuration, moderates Feedback, activates CV versions, reviews analytics, and produces Owner exports.", $tags="", $link="")
ContainerDb(ShipWithAli.PortfolioDatabase, "Portfolio Database", $techn="Supabase PostgreSQL with connection pooling", $descr="Stores module-owned relational records, public read projections, immutable histories, idempotency records, outbox entries, and job leases under Row Level Security.", $tags="", $link="")
System(VercelPlatform, "Vercel Platform", $descr="Provides CDN delivery, serverless execution, cache tags, preview promotion, rollback, and scheduled invocation.", $tags="", $link="")

Rel(Visitor, ShipWithAli.NextjsApplication.PublicExperience, "1: Consents and emits an allowlisted public event", $techn="HTTPS", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.PublicExperience, ShipWithAli.NextjsApplication.Measurement, "2: Records the event with an idempotency key", $techn="In-process TypeScript interface", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.Measurement, ShipWithAli.NextjsApplication.IdentityandAccess, "3: Validates consent and analytics-purpose identity", $techn="In-process TypeScript interface", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.Measurement, ShipWithAli.NextjsApplication.ProviderAdapters, "4: Stores minimized event and aggregation work", $techn="Transaction and repository port", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.ProviderAdapters, ShipWithAli.PortfolioDatabase, "5: Commits raw event and outbox records", $techn="PostgreSQL over TLS", $tags="", $link="")
Rel(VercelPlatform, ShipWithAli.NextjsApplication.PortabilityandOperations, "6: Invokes a scheduled job batch", $techn="Authenticated HTTPS", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.PortabilityandOperations, ShipWithAli.NextjsApplication.Measurement, "7: Runs idempotent aggregation and retention", $techn="In-process idempotent job handler", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.Measurement, ShipWithAli.NextjsApplication.ProviderAdapters, "8: Writes daily aggregates and removes expired detail", $techn="Transaction and repository port", $tags="", $link="")
Rel(Owner, ShipWithAli.NextjsApplication.OwnerWorkspace, "9: Requests a goal-versioned report", $techn="HTTPS", $tags="", $link="")
Rel(ShipWithAli.NextjsApplication.OwnerWorkspace, ShipWithAli.NextjsApplication.Measurement, "10: Queries aggregates with Low-sample policy", $techn="In-process TypeScript interface", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml
