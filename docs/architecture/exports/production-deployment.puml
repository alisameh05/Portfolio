@startuml
title <size:24>Deployment View: ShipWithAli - Production</size>\n<size:24>Production mapping across Vercel, Supabase, GitHub, Resend, and Sentry.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Deployment>

Deployment_Node(Production.VisitorDevice, "Visitor Device", $type="Modern browser", $descr="An untrusted desktop or mobile device.", $tags="", $link="") {
  Deployment_Node(Production.VisitorDevice.WebBrowser, "Web Browser", $type="HTML, CSS, JavaScript", $descr="Runs progressively enhanced public or Owner UI code.", $tags="", $link="")
}

Deployment_Node(Production.Vercel, "Vercel", $type="Vercel", $descr="Managed edge delivery and serverless runtime.", $tags="", $link="") {
  Deployment_Node(Production.Vercel.CDNandCache, "CDN and Cache", $type="Vercel CDN", $descr="Terminates HTTPS and serves cached public responses and static assets.", $tags="", $link="")
  Deployment_Node(Production.Vercel.ApplicationRuntime, "Application Runtime", $type="Vercel Functions", $descr="Runs the one modular-monolith deployment and authenticated scheduled entry points.", $tags="", $link="") {
    Container(Production.Vercel.ApplicationRuntime.NextjsApplication_1, "Next.js Application", $techn="Next.js App Router, React, TypeScript, Vercel Functions", $descr="Server-renders public routes, hosts the Owner workspace and narrow mutation routes, executes domain modules, and dispatches scheduled work as one deployment.", $tags="", $link="")
  }

}

Deployment_Node(Production.Supabase, "Supabase", $type="Supabase", $descr="Managed application data plane.", $tags="", $link="") {
  System(Production.Supabase.SupabaseAuth_1, "Supabase Auth", $descr="Creates application sessions and delegates the Owner identity challenge to GitHub OAuth.", $tags="", $link="")
  Deployment_Node(Production.Supabase.DatabaseRuntime, "Database Runtime", $type="Supabase PostgreSQL", $descr="Hosts pooled PostgreSQL and Row Level Security.", $tags="", $link="") {
    ContainerDb(Production.Supabase.DatabaseRuntime.PortfolioDatabase_1, "Portfolio Database", $techn="Supabase PostgreSQL with connection pooling", $descr="Stores module-owned relational records, public read projections, immutable histories, idempotency records, outbox entries, and job leases under Row Level Security.", $tags="", $link="")
  }

  Deployment_Node(Production.Supabase.StorageRuntime, "Storage Runtime", $type="Supabase Storage", $descr="Hosts private candidates, accepted public variants, CVs, exports, and recovery artifacts.", $tags="", $link="") {
    Container(Production.Supabase.StorageRuntime.ObjectStorage_1, "Object Storage", $techn="Supabase Storage through an object-storage adapter", $descr="Keeps private upload candidates, accepted public media variants, Current CV objects, encrypted exports, and recovery artifacts behind stable Media asset identities.", $tags="", $link="")
  }

}

Deployment_Node(Production.GitHubCloud, "GitHub Cloud", $type="GitHub", $descr="Hosts identity and CI/CD capabilities.", $tags="", $link="") {
  System(Production.GitHubCloud.GitHubOAuth_1, "GitHub OAuth", $descr="Authenticates the Owner's GitHub identity; access is granted only when the immutable provider subject is allowlisted.", $tags="", $link="")
  System(Production.GitHubCloud.GitHubActions_1, "GitHub Actions", $descr="Runs tests, architecture checks, expand-contract migration gates, deployment promotion, encrypted backups, and restore rehearsals.", $tags="", $link="")
}

Deployment_Node(Production.VercelControlPlane, "Vercel Control Plane", $type="Vercel", $descr="Hosts deployment, cache, and schedule controls.", $tags="", $link="") {
  System(Production.VercelControlPlane.VercelPlatform_1, "Vercel Platform", $descr="Provides CDN delivery, serverless execution, cache tags, preview promotion, rollback, and scheduled invocation.", $tags="", $link="")
}

Deployment_Node(Production.ResendCloud, "Resend Cloud", $type="Resend", $descr="Hosts transactional email delivery.", $tags="", $link="") {
  System(Production.ResendCloud.Resend_1, "Resend", $descr="Delivers best-effort actionable Owner notifications without participating in publication transactions.", $tags="", $link="")
}

Deployment_Node(Production.SentryCloud, "Sentry Cloud", $type="Sentry", $descr="Hosts scrubbed error and trace ingestion.", $tags="", $link="") {
  System(Production.SentryCloud.Sentry_1, "Sentry", $descr="Receives scrubbed exceptions and sampled traces for actionable operational diagnosis.", $tags="", $link="")
}

Rel(Production.Vercel.ApplicationRuntime.NextjsApplication_1, Production.Supabase.SupabaseAuth_1, "Establishes and refreshes Owner sessions", $techn="Supabase Auth over HTTPS", $tags="", $link="")
Rel(Production.Vercel.ApplicationRuntime.NextjsApplication_1, Production.Supabase.DatabaseRuntime.PortfolioDatabase_1, "Reads and writes module-owned records through pooled connections", $techn="PostgreSQL over TLS", $tags="", $link="")
Rel(Production.Vercel.ApplicationRuntime.NextjsApplication_1, Production.Supabase.StorageRuntime.ObjectStorage_1, "Reads and writes private and accepted objects through signed operations", $techn="Supabase Storage HTTPS API", $tags="", $link="")
Rel(Production.Supabase.SupabaseAuth_1, Production.GitHubCloud.GitHubOAuth_1, "Delegates the Owner identity challenge", $techn="OAuth 2.0 over HTTPS", $tags="", $link="")
Rel(Production.GitHubCloud.GitHubActions_1, Production.Supabase.DatabaseRuntime.PortfolioDatabase_1, "Applies gated migrations and creates encrypted logical backups", $techn="PostgreSQL over TLS", $tags="", $link="")
Rel(Production.GitHubCloud.GitHubActions_1, Production.Supabase.StorageRuntime.ObjectStorage_1, "Creates encrypted weekly storage and Owner-export artifacts", $techn="Supabase Storage HTTPS API", $tags="", $link="")
Rel(Production.VercelControlPlane.VercelPlatform_1, Production.Vercel.ApplicationRuntime.NextjsApplication_1, "Delivers cached requests to the application", $techn="Vercel CDN and HTTPS", $tags="", $link="")
Rel(Production.Vercel.ApplicationRuntime.NextjsApplication_1, Production.VercelControlPlane.VercelPlatform_1, "Invalidates tagged caches and reports runtime health", $techn="Vercel runtime interface", $tags="", $link="")
Rel(Production.GitHubCloud.GitHubActions_1, Production.VercelControlPlane.VercelPlatform_1, "Promotes verified previews and selects prior deployments for rollback", $techn="Vercel HTTPS API", $tags="", $link="")
Rel(Production.Vercel.ApplicationRuntime.NextjsApplication_1, Production.ResendCloud.Resend_1, "Sends best-effort notifications", $techn="Resend HTTPS API", $tags="", $link="")
Rel(Production.Vercel.ApplicationRuntime.NextjsApplication_1, Production.SentryCloud.Sentry_1, "Reports scrubbed failures and traces", $techn="Sentry HTTPS ingestion", $tags="", $link="")
Rel(Production.VisitorDevice.WebBrowser, Production.Vercel.CDNandCache, "Requests public or Owner routes", $techn="HTTPS", $tags="", $link="")
Rel(Production.Vercel.CDNandCache, Production.Vercel.ApplicationRuntime.NextjsApplication_1, "Serves cached responses or routes cache misses", $techn="Vercel internal HTTPS", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml
