@startuml
title <size:24>System Context View: ShipWithAli</size>\n<size:24>Measured service-extraction candidates; none are active in the first release.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>

System(FutureMeasurementService, "Future Measurement Service", $descr="Conditional extraction target when event volume exceeds one million per day or aggregation delays operational transactions.", $tags="", $link="")
System(FutureMediaService, "Future Media Service", $descr="Conditional extraction target when processing exceeds serverless limits or backlog remains above five minutes.", $tags="", $link="")
System(FutureInteractionService, "Future Interaction Service", $descr="Conditional extraction target when public interactions exceed 250 sustained writes per second.", $tags="", $link="")
System(FutureSearchService, "Future Search Service", $descr="Conditional read-model extraction when public documents exceed 100,000 and tuned PostgreSQL search remains above 300 ms p95.", $tags="", $link="")
System(ShipWithAli, "ShipWithAli", $descr="Serves the bilingual public portfolio and the Owner workspace while preserving evidence-led publication, privacy, resilience, and portability.", $tags="", $link="")

Rel(ShipWithAli, FutureMeasurementService, "May extract Measurement after its quantitative or ownership trigger", $techn="Versioned outbox events and HTTPS", $tags="", $link="")
Rel(ShipWithAli, FutureMediaService, "May extract Media after its quantitative or ownership trigger", $techn="Versioned outbox events and HTTPS", $tags="", $link="")
Rel(ShipWithAli, FutureInteractionService, "May extract Interaction and Moderation after its quantitative or ownership trigger", $techn="Versioned outbox events and HTTPS", $tags="", $link="")
Rel(ShipWithAli, FutureSearchService, "May extract the public search projection after its quantitative or ownership trigger", $techn="Versioned outbox events and HTTPS", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml
