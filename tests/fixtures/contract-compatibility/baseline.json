{
  "openapi": "3.1.0",
  "info": {
    "title": "Compatibility fixture",
    "version": "1.0.0"
  },
  "security": [
    {
      "OwnerSession": []
    }
  ],
  "paths": {
    "/widgets": {
      "post": {
        "operationId": "createWidget",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWidget"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Widget"
                }
              }
            }
          },
          "422": {
            "description": "Rejected"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OwnerSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "CreateWidget": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "mode"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "mode": {
            "type": "string",
            "enum": [
              "standard",
              "express"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      },
      "Widget": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  }
}
