{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shipwithali:owner-export-schema:media-metadata:1.0",
  "title": "Portable Media metadata record 1.0 (legacy flat record)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope",
    "mediaId",
    "kind",
    "state",
    "accessibilityMetadata",
    "processingHistory",
    "decisionHistory",
    "publicationState",
    "portableReference"
  ],
  "properties": {
    "scope": {
      "const": "media-metadata"
    },
    "mediaId": {
      "$ref": "#/$defs/stableId"
    },
    "kind": {
      "enum": [
        "image",
        "video",
        "document"
      ]
    },
    "state": {
      "enum": [
        "upload-pending",
        "processing",
        "processed",
        "accepted",
        "rejected"
      ]
    },
    "accessibilityMetadata": {
      "anyOf": [
        {
          "$ref": "#/$defs/accessibilityMetadata"
        },
        {
          "type": "null"
        }
      ]
    },
    "processingHistory": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/processing"
      }
    },
    "decisionHistory": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "publicationState": {
      "enum": [
        "private",
        "accepted",
        "published",
        "withdrawn"
      ]
    },
  "portableReference": {
   "type": "string"
  }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "accessibilityMetadata": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "altText"
          ],
          "properties": {
            "kind": {
              "const": "described-image"
            },
            "altText": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "decorative-image"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "summary"
          ],
          "properties": {
            "kind": {
              "const": "video"
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "summary"
          ],
          "properties": {
            "kind": {
              "const": "document"
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        }
      ]
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "detectedMediaType",
        "detectedByteLength",
        "sha256",
        "findings",
        "recordedAt"
      ],
      "properties": {
        "result": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "detectedMediaType": {
          "type": "string"
        },
        "detectedByteLength": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "findings": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "recordedAt": {
          "$ref": "#/$defs/utcInstant"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "decidedAt"
      ],
      "properties": {
        "decision": {
          "enum": [
            "accepted",
            "rejected"
          ]
        },
        "decidedAt": {
          "$ref": "#/$defs/utcInstant"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "utcInstant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    }
  }
}
