{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shipwithali:owner-export-schema:cv-metadata:1.0",
  "title": "Portable CV metadata record 1.0 (legacy flat record)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope",
    "aggregateVersion",
    "currentVersionId",
    "versions",
    "activationHistory"
  ],
  "properties": {
    "scope": {
      "const": "cv-metadata"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "currentVersionId": {
      "anyOf": [
        {
          "$ref": "#/$defs/stableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "versions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "versionId",
          "mediaId",
          "locale",
          "label",
          "state",
          "isCurrent"
        ],
        "properties": {
          "versionId": {
            "$ref": "#/$defs/stableId"
          },
          "mediaId": {
            "$ref": "#/$defs/stableId"
          },
          "locale": {
            "const": "en"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "state": {
            "enum": [
              "registered",
              "accepted"
            ]
          },
          "isCurrent": {
            "type": "boolean"
          }
        }
      }
    },
    "activationHistory": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "versionId",
          "activatedAt"
        ],
        "properties": {
          "versionId": {
            "$ref": "#/$defs/stableId"
          },
          "activatedAt": {
            "$ref": "#/$defs/utcInstant"
          }
        }
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utcInstant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    }
  }
}
