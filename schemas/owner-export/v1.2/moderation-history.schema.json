{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shipwithali:owner-export-schema:moderation-history:1.2",
  "title": "Retention-aware moderation history record 1.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "value"],
  "properties": {
    "scope": { "const": "moderation-history" },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feedbackId", "projectId", "locale", "aggregateVersion", "state", "textDisposition", "submittedAt", "decisionHistory"],
      "properties": {
        "feedbackId": { "$ref": "#/$defs/stableId" },
        "projectId": { "$ref": "#/$defs/stableId" },
        "locale": { "enum": ["en", "ar"] },
        "aggregateVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "state": { "enum": ["pending", "approved", "rejected", "suppressed"] },
        "textDisposition": { "enum": ["retained", "erased"] },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "paragraph": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "submittedAt": { "$ref": "#/$defs/utcInstant" },
        "decisionHistory": {
          "type": "array",
          "items": { "$ref": "#/$defs/decision" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "textDisposition": { "const": "retained" } } },
          "then": { "properties": { "authorName": {}, "paragraph": {} }, "required": ["authorName", "paragraph"] },
          "else": { "properties": { "authorName": false, "paragraph": false } }
        },
        {
          "if": { "properties": { "state": { "const": "pending" } } },
          "then": { "properties": { "decisionHistory": { "type": "array", "maxItems": 0 } } },
          "else": { "properties": { "decisionHistory": { "type": "array", "minItems": 1 } } }
        },
        {
          "if": { "properties": { "textDisposition": { "const": "erased" } }, "required": ["textDisposition"] },
          "then": { "properties": { "decisionHistory": { "type": "array", "items": { "type": "object", "properties": { "reason": false } } } } }
        }
      ]
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utcInstant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "decision", "decidedAt"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "decision": { "enum": ["approved", "rejected", "suppressed"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "decidedAt": { "$ref": "#/$defs/utcInstant" }
      }
    }
  }
}
