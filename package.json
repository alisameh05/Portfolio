{
  "name": "shipwithali-portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ShipWithAli backend — Phase 1 architecture alignment and contracts",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "setup:validation": "node scripts/setup-validation.mjs",
    "validation:ready": "node scripts/validation-environment.mjs",
    "test:setup": "node --test --test-isolation=none tests/tooling/*.test.mjs",
    "pretypecheck": "npm run validation:ready",
    "prephase4:focus:context": "npm run validation:ready",
    "build": "next build",
    "lint": "eslint .",
    "contract:lint": "redocly check-config && redocly lint public@v1 owner@v1",
    "contract:bundle": "npm run contract:bundle:public && npm run contract:bundle:owner",
    "contract:bundle:public": "redocly bundle public@v1 --output openapi/generated/public-v1.json --ext json",
    "contract:bundle:owner": "redocly bundle owner@v1 --output openapi/generated/owner-v1.json --ext json",
    "contract:generate": "npm run contract:lint && node scripts/generate-contract-artifacts.mjs",
    "contract:drift": "node scripts/check-contract-drift.mjs",
    "contract:compatibility": "node scripts/check-contract-compatibility.mjs",
    "contract:verify": "npm run contract:generate && npm run contract:drift && npm run contract:compatibility",
    "contract:docs": "node scripts/build-contract-reference.mjs",
    "route:inventory": "node scripts/check-route-inventory.mjs",
    "runtime:boundary": "node scripts/check-runtime-boundary.mjs",
    "runtime:architecture": "node scripts/check-runtime-architecture.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:arch": "node scripts/architecture-check.mjs",
    "test:contracts": "npm run contract:verify && vitest run tests/contracts",
    "test:runtime:configuration": "vitest run tests/runtime/configuration.test.ts",
    "test:runtime:http": "vitest run tests/runtime",
    "test:runtime:problem": "vitest run tests/runtime/problem.test.ts",
    "test:runtime:health": "vitest run tests/runtime/livez.test.ts tests/runtime/readiness-lifecycle.test.ts",
    "db:verify": "node scripts/check-database-toolchain.mjs",
    "db:start": "node scripts/local-database.mjs start",
    "db:status": "node scripts/local-database.mjs status",
    "db:reset": "node scripts/local-database.mjs reset",
    "db:reuse": "node scripts/local-database.mjs reuse",
    "db:stop": "node scripts/local-database.mjs stop",
    "db:baseline:verify": "node scripts/check-database-baseline.mjs --source-only",
    "db:baseline:test": "node scripts/check-database-baseline.mjs --local",
    "db:phase3:source": "node scripts/check-phase3-database.mjs --source-only",
    "db:phase3:migrations": "node scripts/check-database-baseline.mjs --local --phase3",
    "db:phase3:integration": "vitest run tests/database/postgres-integration.test.ts",
    "db:phase3:security": "node scripts/check-phase3-database.mjs",
    "phase3:focus:migration": "node scripts/check-database-baseline.mjs --local --phase3",
    "phase3:focus:source": "node scripts/check-phase3-database.mjs --source-only",
    "phase3:focus:security": "node scripts/check-phase3-database.mjs",
    "phase3:focus:transaction": "node scripts/phase3-database-tests.mjs tests/database/postgres-transaction-runner.test.ts tests/database/postgres-integration.test.ts",
    "phase3:focus:occ": "node scripts/phase3-database-tests.mjs tests/database/optimistic-concurrency.test.ts",
    "phase3:focus:idempotency": "node scripts/phase3-database-tests.mjs tests/database/idempotency.test.ts tests/database/postgres-integration.test.ts",
    "phase3:focus:outbox": "node scripts/phase3-database-tests.mjs tests/database/outbox.test.ts tests/database/postgres-integration.test.ts",
    "phase3:focus:leases": "node scripts/phase3-database-tests.mjs tests/database/leased-jobs.test.ts tests/database/postgres-integration.test.ts",
    "phase3:focus:readiness": "vitest run tests/database/postgres-runtime.test.ts tests/runtime/readiness-lifecycle.test.ts",
    "phase3:focus:role-rls": "node scripts/phase3-database-tests.mjs tests/database/role-rls-matrix.test.ts",
    "phase3:focus:plans": "node scripts/check-phase3-database.mjs",
    "phase1:gate": "node scripts/phase1-gate.mjs",
    "phase2:gate": "node scripts/phase2-gate.mjs",
    "phase3:gate": "node scripts/phase3-gate.mjs",
    "phase4:context": "node scripts/check-phase4-context.mjs",
    "phase4:gate": "node scripts/phase4-gate.mjs",
    "phase4:focus:context": "vitest run tests/phase4",
    "prephase4:focus:settings": "npm run validation:ready",
    "phase4:focus:settings": "node scripts/portfolio-settings-integration.mjs",
    "phase4:focus:local-auth": "node scripts/local-auth-integration.mjs",
    "test:local-auth-runner": "node --test tests/tooling/local-auth-integration.test.mjs",
    "prephase5:context": "npm run validation:ready",
    "phase5:context": "node scripts/check-phase5-context.mjs",
    "prephase5:smoke": "npm run validation:ready",
    "phase5:smoke": "node scripts/phase5-verification.mjs --smoke",
    "phase5:gate": "node scripts/phase5-gate.mjs",
    "prephase5:focus:authoring-review-publication-routes": "node scripts/phase5-scenario-coverage.mjs --invalidate-suite authoring && npm run validation:ready",
    "phase5:focus:authoring-review-publication-routes": "node scripts/phase5-verification.mjs --suite authoring",
      "prephase5:focus:content-authoring-postgres": "npm run validation:ready",
      "phase5:focus:content-authoring-postgres": "node scripts/portfolio-settings-integration.mjs --ticket-109",
      "prephase5:focus:project-publication-postgres": "npm run validation:ready",
      "phase5:focus:project-publication-postgres": "node scripts/portfolio-settings-integration.mjs --ticket-111",
      "prephase5:focus:testimonial-postgres": "npm run validation:ready",
      "phase5:focus:testimonial-postgres": "node scripts/portfolio-settings-integration.mjs --ticket-113",
      "prephase5:focus:achievement-timeline-postgres": "npm run validation:ready",
      "phase5:focus:achievement-timeline-postgres": "node scripts/portfolio-settings-integration.mjs --ticket-112",
    "prephase5:focus:project-routes-postgres": "npm run validation:ready",
    "phase5:focus:project-routes-postgres": "node scripts/portfolio-settings-integration.mjs --ticket-115",
    "prephase5:focus:content-lifecycle-postgres": "npm run validation:ready",
    "phase5:focus:content-lifecycle-postgres": "node scripts/portfolio-settings-integration.mjs --ticket-114",
    "prephase5:focus:project-relationships-postgres": "npm run validation:ready",
    "phase5:focus:project-relationships-postgres": "node scripts/portfolio-settings-integration.mjs --ticket-117",
    "prephase5:focus:project-status-postgres": "npm run validation:ready",
    "phase5:focus:project-status-postgres": "node scripts/portfolio-settings-integration.mjs --ticket-116",
    "prephase5:focus:controlled-taxonomy-postgres": "npm run validation:ready",
    "phase5:focus:controlled-taxonomy-postgres": "node scripts/portfolio-settings-integration.mjs --ticket-118",
    "prephase5:focus:taxonomy-evolution-postgres": "npm run validation:ready",
    "phase5:focus:taxonomy-evolution-postgres": "node scripts/portfolio-settings-integration.mjs --ticket-119",
    "prephase5:focus:taxonomy-merge-postgres": "npm run validation:ready",
    "phase5:focus:taxonomy-merge-postgres": "node scripts/portfolio-settings-integration.mjs --ticket-120",
    "prephase5:focus:project-discovery-postgres": "npm run validation:ready",
    "phase5:focus:project-discovery-postgres": "node scripts/portfolio-settings-integration.mjs --ticket-121",
    "prephase5:focus:taxonomy-status-relationships-discovery": "node scripts/phase5-scenario-coverage.mjs --invalidate-suite taxonomy && npm run validation:ready",
    "phase5:focus:taxonomy-status-relationships-discovery": "node scripts/phase5-verification.mjs --suite taxonomy",
    "prephase5:focus:database-rls-migrations-concurrency": "node scripts/phase5-scenario-coverage.mjs --invalidate-suite database && npm run validation:ready",
    "phase5:focus:database-rls-migrations-concurrency": "node scripts/phase5-verification.mjs --suite database",
    "prephase5:focus:owner-adapters-composition": "node scripts/phase5-scenario-coverage.mjs --invalidate-suite owner && npm run validation:ready",
    "phase5:focus:owner-adapters-composition": "node scripts/portfolio-settings-integration.mjs --ticket-122",
    "prephase5:focus:scenario-traceability": "node scripts/phase5-scenario-coverage.mjs --invalidate-suite traceability && npm run validation:ready",
    "phase5:focus:scenario-traceability": "node scripts/phase5-verification.mjs --suite traceability",
    "prephase5:focus:integrated-scenarios": "node scripts/phase5-scenario-coverage.mjs --invalidate-integrated && npm run validation:ready",
    "phase5:focus:integrated-scenarios": "node scripts/phase5-scenario-coverage.mjs"
  },
  "dependencies": {
    "kysely": "0.29.6",
    "next": "15.5.25",
    "pg": "8.23.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@redocly/cli": "1.34.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "dependency-cruiser": "16.10.3",
    "eslint": "10.11.0",
    "kysely-codegen": "0.20.0",
    "supabase": "2.117.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "uuidv7": "1.0.2",
    "valibot": "1.1.0",
    "vitest": "3.2.4",
    "zod": "3.25.51"
  }
}
