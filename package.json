{
  "name": "shipwithali-portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ShipWithAli backend — Phase 1 architecture alignment and contracts",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "contract:lint": "redocly check-config && redocly lint shipwithali@v1",
    "contract:bundle": "redocly bundle shipwithali@v1 --output openapi/generated/public-v1.json --ext json",
    "contract:generate": "npm run contract:lint && npm run contract:bundle && openapi-ts && node scripts/strictify-generated-zod.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:arch": "node scripts/architecture-check.mjs",
    "test:contracts": "npm run contract:generate && vitest run tests/contracts",
    "phase1:gate": "node scripts/phase1-gate.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "1.34.3",
    "dependency-cruiser": "16.10.3",
    "@hey-api/openapi-ts": "0.99.0",
    "typescript": "6.0.3",
    "uuidv7": "1.0.2",
    "valibot": "1.1.0",
    "vitest": "3.2.4",
    "zod": "3.25.51"
  }
}
