{
  "name": "shipwithali-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "contract:lint": "redocly check-config && redocly lint shipwithali@v1",
    "contract:bundle": "redocly bundle shipwithali@v1 --output openapi/generated/public-v1.json --ext json",
    "contract:generate": "npm run contract:lint && npm run contract:bundle && openapi-ts && node scripts/strictify-generated-zod.mjs",
    "contract:check": "node scripts/check-contract-drift.mjs",
    "contract:docs": "node scripts/build-contract-docs.mjs",
    "test": "vitest run --pool=threads --maxWorkers=1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@redocly/cli": "2.52.1",
    "@types/node": "22.20.2",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
