# .env.example — Phase 3 runtime environment inventory.
#
# Active Phase 2 runtime (required):
#   NODE_ENV: development | test | production
#   APP_BASE_URL: absolute HTTP(S) URL; HTTPS required in production except
#     for an explicit loopback test context (http://localhost, 127.0.0.1, ::1).
#
# Database-enabled application and worker composition additionally requires
# DATABASE_URL with a process-specific least-privilege principal. The base
# Phase 2 runtime still requires only the two values above.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# --- Active only for database-enabled application/worker composition ---
DATABASE_URL=

# --- Required for the Phase 4 Owner profile command in application runtime ---
# UUIDv7 values must match the settings aggregate created by controlled provisioning.
PORTFOLIO_ID=
OWNER_ID=

# --- Tooling-only direct database access; never read by runtime composition ---
DATABASE_DIRECT_URL=

# --- Future placeholders (not read by Phase 3 runtime) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MEDIA_UPLOAD_REPLAY_ENCRYPTION_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_ID=
SUPABASE_DB_PASSWORD=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OWNER_GITHUB_SUBJECTS=
FUNCTIONAL_ID_HASH_KEY=
FUNCTIONAL_ID_HASH_KEY_VERSION=
FUNCTIONAL_ID_HASH_PREVIOUS_KEYS=
MEASUREMENT_ID_HASH_KEY=
MEASUREMENT_ID_HASH_KEY_VERSION=
MEASUREMENT_ID_HASH_PREVIOUS_KEYS=
CRON_TRIGGER_SECRET=
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
TESTSPRITE_API_KEY=
TESTSPRITE_PROJECT_ID=
BACKUP_ENCRYPTION_KEY=
BACKUP_KEY_VERSION=
BACKUP_DESTINATION_NAME=
BACKUP_DESTINATION_URL=
BACKUP_DESTINATION_TOKEN=
BACKUP_RETENTION_HOURS=
BACKUP_SOURCE_ALLOWLIST=
BACKUP_ENVIRONMENT=
PG_DUMP_BIN=
PG_DUMPALL_BIN=
GHCR_IMAGE=
FEEDBACK_RATE_LIMIT_MAX_REQUESTS=30
FEEDBACK_RATE_LIMIT_WINDOW_SECONDS=60
