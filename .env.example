# .env.example — Phase 2 #25 environment inventory.
#
# Active Phase 2 runtime (required):
#   NODE_ENV: development | test | production
#   APP_BASE_URL: absolute HTTP(S) URL; HTTPS required in production except
#     for an explicit loopback test context (http://localhost, 127.0.0.1, ::1).
#
# Future variables below are documented placeholders only. They are neither
# read nor required in Phase 2 and carry no fabricated credentials.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# --- Future placeholders (not read in Phase 2) ---
DATABASE_URL=
DATABASE_DIRECT_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_ID=
SUPABASE_DB_PASSWORD=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OWNER_GITHUB_SUBJECTS=
FUNCTIONAL_ID_HASH_KEY=
MEASUREMENT_ID_HASH_KEY=
CRON_TRIGGER_SECRET=
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
TESTSPRITE_API_KEY=
TESTSPRITE_PROJECT_ID=
BACKUP_ENCRYPTION_KEY=
GHCR_IMAGE=
